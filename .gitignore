# ==============================================================================
# Ambientes virtuais e caches do Python
# ==============================================================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# ==============================================================================
# Node / frontend
# ==============================================================================
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*

# ==============================================================================
# Configuração e segredos locais (use config_exemple.yaml como modelo)
# ==============================================================================
config.yaml
.env
.env.*
!.env.example

# Restos da tentativa anterior de frontend (será recriado em frontend/)
/package.json
/package-lock.json
/__init__.py
CRIAR_FRONTEND.bat
COPIAR_PROJETO.bat

# Marcador local do ai-memory (escolha de captura de cada máquina)
.ai-memory.toml

# ==============================================================================
# Arquivos gerados: relatórios, temporários do Excel e uploads
# ==============================================================================
# Mantém apenas o template oficial versionado; qualquer outro .xlsx em templates/ é local
templates/*.xlsx
!templates/model.xlsx
relatorio_final*.xlsx
model_base.xlsx
~$*.xls*
*.tmp
output/
uploads/
data/

# Fotos de obra (pesadas e privadas; nunca versionar)
images/
images_organized/

# ==============================================================================
# Scripts e dados de teste manuais (saídas de ~35 MB cada)
# ==============================================================================
test/

# ==============================================================================
# Logs
# ==============================================================================
*.log
logs/

# ==============================================================================
# Sistema operacional
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini

# ==============================================================================
# IDEs e ferramentas locais
# ==============================================================================
.vscode/
.idea/
.claude/settings.local.json

# Worktrees temporários de agentes
.claude/worktrees/

# Áreas de trabalho da API (envios e relatórios gerados)
work/
