# ESBOÇO INATIVO: nada aqui é usado pelo projeto hoje (não há Docker nesta máquina e este
# arquivo nunca foi construído). Ver docs/docker/README.md antes de ativar.
#
# Para ativar: copie para ./Dockerfile na raiz, copie dockerignore.sketch para ./.dockerignore
# e substitua o escritor de imagens por uma implementação sem Excel (ver README).

# --- 1) compila a interface -----------------------------------------------------------
FROM node:22-slim AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# --- 2) ambiente Python (sem Excel, sem dependências de desenvolvimento) -----------------
FROM python:3.12-slim AS app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app

# Dependências primeiro, para aproveitar o cache de camadas. O xlwings só é instalado em
# Windows (marcador no pyproject.toml), então não entra nesta imagem.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-install-project --no-default-groups
COPY src ./src
RUN uv sync --frozen --no-default-groups

COPY --from=web /web/dist ./frontend/dist

# --- configuração por variáveis de ambiente (ver src/report_works/adapters/settings.py) ---
ENV PATH="/app/.venv/bin:$PATH" \
    REPORT_WORKDIR=/data \
    REPORT_STATIC_DIR=/app/frontend/dist \
    REPORT_HOST=0.0.0.0 \
    REPORT_PORT=8000

RUN useradd --system --uid 10001 --home-dir /nonexistent report \
    && mkdir -p /data && chown report /data
USER report
VOLUME ["/data"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3)"

CMD ["python", "-m", "report_works"]
